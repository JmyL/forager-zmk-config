#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

#include <behaviors/rgbled_widget.dtsi>

#define ZMK_POINTING_DEFAULT_MOVE_VAL 1800
#define ZMK_POINTING_DEFAULT_SCRL_VAL 40
#include <dt-bindings/zmk/pointing.h>

#define BASE  0
#define NUM   1
#define SYM   2
#define SHIFT 3
#define MOV   4
#define CFG   5

/ {
    behaviors {
        lhm: left_homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            retro-tap;
            bindings = <&kp>, <&kp>;
        };
        rhm: right_homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            retro-tap;
            bindings = <&kp>, <&kp>;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";
        cfg_layer {
            if-layers = <NUM SYM>;
            then-layer = <CFG>;
        };
    };

    combos {
        compatible = "zmk,combos";

        left_thumb_cfg {
            timeout-ms = <50>;
            key-positions = <30 31>;
            bindings = <&mo CFG>;
        };

        right_thumb_cfg {
            timeout-ms = <50>;
            key-positions = <32 33>;
            bindings = <&mo CFG>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            bindings = <
            &kp Q           &kp W           &kp E           &kp R           &kp T                                           &kp Y           &kp U           &kp I           &kp O           &kp P
            &lhm LCTRL A    &lhm LSHFT S    &lhm LALT D     &lhm LGUI F     &kp G                                           &kp H           &rhm LGUI J     &rhm RALT K     &rhm LSHFT L    &rhm LCTRL SEMI
            &lt MOV Z       &kp X           &kp C           &kp V           &kp B                                           &kp N           &kp M           &kp COMMA       &kp DOT         &kp FSLH
                                                                            &mo NUM         &mo SHIFT       &mo SYM         &kp SPACE
            >;
        };

        num {
            bindings = <
            &kp N1          &kp N2          &kp N3          &kp N4          &kp N5                                          &kp N6          &kp N7          &kp N8          &kp N9          &kp N0
            &kp TAB         &kp LS(TAB)     &kp DEL         &kp BSPC        &kp LS(F10)                                     &kp LEFT        &kp DOWN        &kp UP          &kp RIGHT       &kp ENTER
            &kp LC(Z)       &kp LC(X)       &kp LC(C)       &kp LC(V)       &kp LC(V)                                       &kp HOME        &kp PG_DN       &kp PG_UP       &kp END         &none
                                                                            &trans          &trans          &trans          &kp ESC
            >;
        };

        sym {
            bindings = <
            &kp EXCL        &kp AT          &kp HASH        &kp DLLR        &kp PRCNT                                       &kp CARET       &kp AMPS        &kp ASTRK       &kp LPAR        &kp RPAR
            &kp GRAVE       &kp DQT         &kp MINUS       &kp UNDER       &kp LBKT                                        &kp RBKT        &kp BSPC        &kp PLUS        &kp SQT         &kp COLON
            &kp BSLH        &kp PIPE        &kp TILDE       &kp N0          &kp LBRC                                        &kp RBRC        &kp EQUAL       &kp LT          &kp GT          &kp QMARK
                                                                            &trans          &trans          &trans          &trans
            >;
        };

        shift {
            bindings = <
            &kp LS(Q)       &kp LS(W)       &kp LS(E)       &kp LS(R)       &kp LS(T)                                       &kp LS(Y)       &kp LS(U)       &kp LS(I)       &kp LS(O)       &kp LS(P)
            &kp LS(A)       &kp LS(S)       &kp LS(D)       &kp LS(F)       &kp LS(G)                                       &kp LS(H)       &kp LS(J)       &kp LS(K)       &kp LS(L)       &kp UNDER
            &kp LS(Z)       &kp LS(X)       &kp LS(C)       &kp LS(V)       &kp LS(B)                                       &kp LS(N)       &kp LS(M)       &kp LS(COMMA)   &kp LS(DOT)     &kp LS(FSLH)
                                                                            &trans          &trans          &trans          &kp LS(SPACE)
            >;
        };

        mov {
            bindings = <
            &none           &none           &none           &none           &none                                           &none           &none           &none           &none           &none
            &none           &none           &none           &none           &none                                           &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_UP    &mmv MOVE_RIGHT &mkp MB1
            &none           &none           &none           &none           &none                                           &msc SCRL_LEFT  &msc SCRL_DOWN  &msc SCRL_UP    &msc SCRL_RIGHT &mkp MB2
                                                                            &trans          &trans          &trans          &trans
            >;
        };

        cfg {
            bindings = <
            &kp F1          &kp F2          &kp F3          &kp F4          &kp F5                                          &kp F6          &kp F7          &kp F8          &kp F9          &kp F10
            &kp F11         &kp F12         &none           &ind_bat        &none                                           &none           &ind_con        &kp C_BRI_DN    &kp C_BRI_UP    &studio_unlock
            &bt BT_SEL 0    &bt BT_SEL 1    &bt BT_SEL 2    &bt BT_SEL 3    &bt BT_CLR_ALL                                  &none           &kp C_MUTE      &kp C_VOL_DN    &kp C_VOL_UP    &none
                                                                            &trans          &trans          &trans          &trans
            >;
        };
    };
};
&lt {
    tapping-term-ms = <200>;
    quick-tap-ms = <200>;
};

&mt {
    tapping-term-ms = <200>;
    quick-tap-ms = <200>;
};

&sk {
    release-after-ms = <100>;
    quick-release;
};

&mmv {
    delay-ms = <10>;
    time-to-max-speed-ms = <900>;
    acceleration-exponent = <1>;
};

&msc {
    delay-ms = <100>;
    time-to-max-speed-ms = <100>;
    acceleration-exponent = <0>;
};